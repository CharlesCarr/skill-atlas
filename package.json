{
  "name": "skill-atlas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A document-first atlas for agent skills and the workflows that connect them.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4317",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4317",
    "typecheck": "tsc -b",
    "test": "vitest run tests",
    "test:e2e": "playwright test",
    "import:skills": "node --import tsx scripts/import-skills.ts",
    "check": "npm run format:check && npm run typecheck && npm test && npm run build",
    "verify:public": "node scripts/verify-public-build.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.5",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@xyflow/react": "^12.10.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/dagre": "^0.7.53",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "license": "MIT"
}
