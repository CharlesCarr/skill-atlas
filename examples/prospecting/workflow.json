{
  "version": 1,
  "title": "Prospecting pipeline",
  "description": "From a campaign hypothesis to a verified draft. Four skills, deliberate handoffs, and a human at the finish line.",
  "steps": [
    {
      "id": "ideation",
      "skill": "campaign-ideation",
      "title": "Calibrate the campaign",
      "phase": "01 \u00b7 Strategy",
      "inputs": [
        "Campaign hypothesis",
        "Operator feedback"
      ],
      "outputs": [
        "Selected strategy revision",
        "Execution snapshot"
      ]
    },
    {
      "id": "setup",
      "skill": "campaign-setup",
      "title": "Freeze & coordinate",
      "phase": "02 \u00b7 Preparation",
      "inputs": [
        "Selected strategy revision"
      ],
      "outputs": [
        "Frozen criteria",
        "Preparation checkpoint"
      ]
    },
    {
      "id": "research",
      "skill": "campaign-research",
      "title": "Find the right accounts",
      "phase": "03 \u00b7 Evidence",
      "inputs": [
        "Frozen criteria",
        "Research allowance"
      ],
      "outputs": [
        "Eligible recipients",
        "Source evidence"
      ]
    },
    {
      "id": "draft",
      "skill": "sequence-drafter",
      "title": "Draft the sequence",
      "phase": "03 \u00b7 Messaging",
      "inputs": [
        "Selected claims & tone",
        "Source evidence"
      ],
      "outputs": [
        "Complete sequence proposal"
      ]
    },
    {
      "id": "readback",
      "skill": "campaign-setup",
      "title": "Prepare & verify",
      "phase": "04 \u00b7 Readback",
      "inputs": [
        "Eligible recipients",
        "Sequence proposal"
      ],
      "outputs": [
        "Verified draft",
        "Unresolved exceptions"
      ]
    },
    {
      "id": "review",
      "kind": "human",
      "title": "Review before launch",
      "description": "The operator reviews recipients, rendered messages, sender settings, and schedule. Launch is a separate manual action.",
      "phase": "05 \u00b7 Human decision",
      "inputs": [
        "Verified draft"
      ],
      "outputs": [
        "Operator decision"
      ]
    }
  ],
  "connections": [
    {
      "from": "ideation",
      "to": "setup",
      "label": "Selected revision",
      "type": "handoff",
      "evidence": [
        {
          "path": ".agents/skills/campaign-ideation/SKILL.md",
          "startLine": 27,
          "endLine": 27,
          "quote": "Capture the chosen rules and source evidence in a versioned document. Pass only the concise execution fields to `$campaign-setup`."
        }
      ]
    },
    {
      "from": "setup",
      "to": "research",
      "label": "Frozen criteria",
      "type": "handoff",
      "evidence": [
        {
          "path": ".agents/skills/campaign-setup/SKILL.md",
          "startLine": 20,
          "endLine": 20,
          "quote": "2. Ask `$campaign-research` for eligible, source-backed recipients under the frozen criteria."
        }
      ]
    },
    {
      "from": "setup",
      "to": "draft",
      "label": "Claims & voice",
      "type": "handoff",
      "evidence": [
        {
          "path": ".agents/skills/campaign-setup/SKILL.md",
          "startLine": 21,
          "endLine": 21,
          "quote": "3. Ask `$sequence-drafter` for a complete sequence grounded in the selected claims and tone."
        }
      ]
    },
    {
      "from": "research",
      "to": "readback",
      "label": "Eligible recipients",
      "type": "handoff",
      "evidence": [
        {
          "path": ".agents/skills/campaign-research/SKILL.md",
          "startLine": 38,
          "endLine": 38,
          "quote": "Return eligible recipients and sourced personalization to `$campaign-setup`. Preserve omitted discoveries and exceptions. If the request is research-only, return a reviewable result without enrollment."
        }
      ]
    },
    {
      "from": "draft",
      "to": "readback",
      "label": "Sequence proposal",
      "type": "handoff",
      "evidence": [
        {
          "path": ".agents/skills/sequence-drafter/SKILL.md",
          "startLine": 31,
          "endLine": 31,
          "quote": "Return the complete sequence proposal, selected input revision, factual basis, and uncertainties to `$campaign-setup`."
        }
      ]
    },
    {
      "from": "research",
      "to": "draft",
      "label": "Source evidence",
      "type": "reference",
      "evidence": [
        {
          "path": ".agents/skills/sequence-drafter/SKILL.md",
          "startLine": 20,
          "endLine": 20,
          "quote": "2. Ground personalization in observed account facts from `$campaign-research`."
        }
      ]
    },
    {
      "from": "readback",
      "to": "review",
      "label": "Verified draft",
      "type": "handoff",
      "evidence": [
        {
          "path": ".agents/skills/campaign-setup/SKILL.md",
          "startLine": 40,
          "endLine": 40,
          "quote": "Return the verified draft, selected revision, observation time, and unresolved exceptions. The operator reviews recipients, rendered messages, sender settings, and schedule before any launch."
        }
      ]
    }
  ]
}
